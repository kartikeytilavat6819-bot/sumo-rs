<routes>
    <!-- capacity 2 per taxi: six persons arriving together need several taxi trips. -->
    <vType id="taxi" vClass="taxi" length="5.00" maxSpeed="13.89" accel="2.60" decel="4.50" personCapacity="2">
        <param key="has.taxi.device" value="true"/>
    </vType>
    <route id="AB" edges="A B"/>
    <vehicle id="taxi0" type="taxi" depart="0" route="AB"/>
    <vehicle id="taxi1" type="taxi" depart="0" route="AB"/>
    <person id="p0" depart="10" departPos="100"><ride from="A" to="B" lines="taxi"/></person>
    <person id="p1" depart="10" departPos="100"><ride from="A" to="B" lines="taxi"/></person>
    <person id="p2" depart="10" departPos="100"><ride from="A" to="B" lines="taxi"/></person>
    <person id="p3" depart="11" departPos="100"><ride from="A" to="B" lines="taxi"/></person>
    <person id="p4" depart="11" departPos="100"><ride from="A" to="B" lines="taxi"/></person>
    <person id="p5" depart="11" departPos="100"><ride from="A" to="B" lines="taxi"/></person>
</routes>
