<routes>
    <!-- greedyShared: 2 taxis with capacity 3 serve 6 persons on A to B (rides can share a taxi). -->
    <vType id="taxi" vClass="taxi" length="5.00" maxSpeed="13.89" accel="2.60" decel="4.50" personCapacity="3">
        <param key="has.taxi.device" value="true"/>
    </vType>
    <route id="AB" edges="A B"/>
    <vehicle id="taxi0" type="taxi" depart="0" route="AB"/>
    <vehicle id="taxi1" type="taxi" depart="0" route="AB"/>
    <person id="p0" depart="10" departPos="100"><ride from="A" to="B" lines="taxi"/></person>
    <person id="p1" depart="12" departPos="110"><ride from="A" to="B" lines="taxi"/></person>
    <person id="p2" depart="15" departPos="120"><ride from="A" to="B" lines="taxi"/></person>
    <person id="p3" depart="40" departPos="300"><ride from="A" to="B" lines="taxi"/></person>
    <person id="p4" depart="50" departPos="200"><ride from="A" to="B" lines="taxi"/></person>
    <person id="p5" depart="55" departPos="250"><ride from="A" to="B" lines="taxi"/></person>
</routes>
