<additional>
    <!-- The attribute form (device.rerouting.probability="1" on a vType) is IGNORED by SUMO 1.28;
         the <param> form below is what actually enables the device. This variant exists to prove
         rerouting HAPPENS, not merely that a rerouter file loads: `reroute.add.xml` yields rerouteNo=0
         on both sides, so it never exercised the device. -->
    <vType id="DEFAULT_VEHTYPE">
        <param key="device.rerouting.probability" value="1"/>
        <param key="device.rerouting.period" value="30"/>
    </vType>
    <rerouter id="closeRR" edges="1117867029#0">
        <interval begin="0" end="200">
            <closingReroute id="1117867029#1"/>
        </interval>
    </rerouter>
</additional>
