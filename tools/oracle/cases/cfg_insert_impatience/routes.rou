<routes>
    <!-- A burst that cannot all be inserted at once: eager insertion, a depart-delay cap and a short
         time-to-impatience decide who departs, who waits and who is discarded. -->
    <vType id="car" length="5.00" maxSpeed="13.89" accel="2.60" decel="4.50" sigma="0"/>
    <route id="r" edges="A"/>
    <flow id="burst" type="car" route="r" begin="0.00" end="5.00" number="25" departSpeed="0"/>
    <vehicle id="late" type="car" route="r" depart="12.00" departSpeed="max"/>
</routes>
