<routes>
    <!-- persons with a group attribute: members of one group are served together. -->
    <vType id="taxi" vClass="taxi" length="5.00" maxSpeed="13.89" accel="2.60" decel="4.50">
        <param key="has.taxi.device" value="true"/>
    </vType>
    <route id="AB" edges="A B"/>
    <vehicle id="taxi0" type="taxi" depart="0" route="AB"/>
    <vehicle id="taxi1" type="taxi" depart="0" route="AB"/>
    <person id="p0" depart="10" departPos="100"><ride from="A" to="B" lines="taxi" group="g1"/></person>
    <person id="p1" depart="12" departPos="100"><ride from="A" to="B" lines="taxi" group="g1"/></person>
    <person id="p2" depart="40" departPos="300"><ride from="A" to="B" lines="taxi" group="g2"/></person>
    <person id="p3" depart="41" departPos="300"><ride from="A" to="B" lines="taxi" group="g2"/></person>
</routes>
