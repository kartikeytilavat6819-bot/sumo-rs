    <tag k="historic" v="memorial"/>
    <tag k="inscription" v="Havia chegado a pouco da rua, ele estava em casa com alguns papeis na mão. Eu sabia que algo estava errado, ele nunca está em casa no almoço. Foi ele quem me contou com toda preocupação que o meu exame havia dado positivo."/>
    <tag k="memorial" v="statue"/>
    <tag k="name" v="Vida Positiva"/>
  </node>
