    <vehicle id="car0" type="car" depart="0.00" departSpeed="max"><route edges="N_in S_out"/></vehicle>
    <vehicle id="bike1" type="bike" depart="6.00" departSpeed="max"><route edges="S_in W_out"/></vehicle>
    <vehicle id="car1" type="car" depart="6.00" departSpeed="max"><route edges="E_in W_out"/></vehicle>
