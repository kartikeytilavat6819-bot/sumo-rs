<routes>
    <!-- Fractional depart times / positions so the numeric precision shows up in every output. -->
    <vType id="car" length="5.00" maxSpeed="13.89" accel="2.60" decel="4.50" sigma="0"/>
    <route id="r" edges="A"/>
    <vehicle id="v0" type="car" route="r" depart="0.50" departPos="1.25" departSpeed="max"/>
    <vehicle id="v1" type="car" route="r" depart="2.25" departPos="0.75" departSpeed="max"/>
    <vehicle id="v2" type="car" route="r" depart="5.75" departPos="2.50" departSpeed="max"/>
    <flow id="f" type="car" route="r" begin="10.00" end="60.00" period="5.00" departSpeed="max"/>
</routes>
