<routes>
    <vType id="slow" carFollowModel="Krauss" length="5.00" maxSpeed="9.00" accel="2.00" decel="3.00"/>
    <vType id="cacc" carFollowModel="CACC" length="5.00" maxSpeed="25.00" accel="2.00" decel="3.00" tau="1.00" minGap="2.00" sigma="0.0">
        <param key="speedControlGainCACC" value="-0.60"/>
        <param key="gapClosingControlGainGap" value="0.01"/>
        <param key="gapClosingControlGainGapDot" value="0.07"/>
        <param key="gapControlGainGap" value="0.55"/>
