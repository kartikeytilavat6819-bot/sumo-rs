<routes>
    <!-- Departures spread across the horizon exercise both full and incremental route loading. -->
    <vType id="car" length="5.00" maxSpeed="13.89" accel="2.60" decel="4.50" sigma="0"/>
    <route id="r" edges="A"/>
    <vehicle id="v0" type="car" route="r" depart="0" departSpeed="max"/>
    <vehicle id="v1" type="car" route="r" depart="60" departSpeed="max"/>
    <vehicle id="v2" type="car" route="r" depart="120" departSpeed="max"/>
    <flow id="f" type="car" route="r" begin="20.00" end="140.00" period="15.00" departSpeed="max"/>
</routes>
