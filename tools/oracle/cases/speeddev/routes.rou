<routes>
    <!-- speedDev draws the speedFactor per vehicle from the RNG; the seed decides the draw order. -->
    <vType id="sdev0" speedDev="0.0" length="5.00" maxSpeed="13.89" accel="2.60" decel="4.50"/>
    <vType id="sdev05" speedDev="0.05" length="5.00" maxSpeed="13.89" accel="2.60" decel="4.50"/>
    <vType id="sdev20" speedDev="0.20" length="5.00" maxSpeed="13.89" accel="2.60" decel="4.50"/>
    <route id="r0" edges="A"/>
    <flow id="f0" type="sdev0" route="r0" begin="0" end="120" period="10"/>
    <flow id="f5" type="sdev05" route="r0" begin="0" end="120" period="10"/>
    <flow id="f20" type="sdev20" route="r0" begin="0" end="120" period="10"/>
</routes>
