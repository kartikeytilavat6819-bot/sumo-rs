<additional>
    <!-- GSP procedure: the switch is only carried out when both programs reach their GSP time. -->
    <tlLogic id="nC" type="static" programID="progA" offset="0">
        <param key="GSP" value="0"/>
        <phase duration="20" state="GGggrrrrGGggrrrr"/>
        <phase duration="3" state="yyyyrrrryyyyrrrr"/>
        <phase duration="20" state="rrrrGGggrrrrGGgg"/>
        <phase duration="3" state="rrrryyyyrrrryyyy"/>
    </tlLogic>
    <tlLogic id="nC" type="static" programID="progB" offset="10">
        <param key="GSP" value="10"/>
        <phase duration="25" state="GGggrrrrGGggrrrr"/>
        <phase duration="4" state="yyyyrrrryyyyrrrr"/>
        <phase duration="25" state="rrrrGGggrrrrGGgg"/>
        <phase duration="4" state="rrrryyyyrrrryyyy"/>
    </tlLogic>
    <WAUT id="waut0" refTime="0" startProg="progA">
        <wautSwitch time="100" to="progB"/>
        <wautSwitch time="200" to="progA"/>
        <wautSwitch time="300" to="progB"/>
    </WAUT>
    <wautJunction junctionID="nC" procedure="GSP" wautID="waut0"/>
</additional>
