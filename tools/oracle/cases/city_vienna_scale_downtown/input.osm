  <node id="12966514263" lat="48.2117175" lon="16.3734455" version="1" timestamp="2025-07-01T14:30:58Z" changeset="168356775" uid="472814" user="paoso">
    <tag k="description" v="Erinnerungstafel an die Beschießung durch die Türken 1683. Über der Tafel eine Nische mit einem rundlichen, 79 Pfund schweren Stein"/>
    <tag k="historic" v="memorial"/>
    <tag k="inscription" v="Anno 1683 Iahr / Den 20 Ivlÿ Ist Dis/er Stein Avs Einer / Mörser V. Den Dÿrckhe / Avs Der LeoboldSta/tt Herein Geworff/en Worden Wegt / 79 Pfvndt"/>
    <tag k="inscription:en" v="On July 20, 1683, this stone was thrown in from a mortar by the Turks from Leopoldstadt; it weighs 79 pounds."/>
    <tag k="memorial" v="plaque"/>
    <tag k="name" v="Türkenstein"/>
    <tag k="wikimedia_commons" v="File:Wien, Sterngasse, Türkische Kanonenkugel -- 2018 -- 3105.jpg"/>
  </node>
