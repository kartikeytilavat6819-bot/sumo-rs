    <tag k="historic" v="memorial"/>
    <tag k="inscription" v="Dank und Anerkennung den Gerechten unter den Völkern, welche in den Jahren der Schoah unter Einsatz ihres Lebens Juden geholfen haben, den Nachstellungen der Nazischergen zu entgehen und so zu überleben.|Die Jüdischen Gemeinden Österreichs|Wien, April2001"/>
    <tag k="material" v="granite"/>
    <tag k="memorial" v="plaque"/>
    <tag k="start_date" v="2001-04"/>
    <tag k="wikimedia_commons" v="File:Jüdisches_Museum_Tafel_1.JPG"/>
  </node>
  <node id="9561519551" lat="48.2115421" lon="16.3694129" version="3" timestamp="2025-06-28T11:03:28Z" changeset="168222240" uid="472814" user="paoso">
    <tag k="description" v="Gedenktafel zur Erinnerung an die Wiener Gesera (Vertreibung und Ermordung der Wiener Juden im Jahr 1420/21)"/>
    <tag k="historic" v="memorial"/>
    <tag k="inscription" v="„Kiddusch HaSchem“ heißt „Heiligung Gottes“. Mit diesem Bewußtsein wählten Juden … zur Zeit der Verfolgung 1420/21 den Freitod, um einer … Zwangstaufe zu entgehen. Andere, etwa 200, wurden in Erdberg auf einem Scheiterhaufen lebendig verbrannt. …"/>
    <tag k="memorial" v="plaque"/>
    <tag k="name" v="Wiener Gesera"/>
    <tag k="source:inscription" v="de.wikipedia.org/wiki/Judenplatz_(Wien)#Gedenktafel"/>
    <tag k="start_date" v="1998-10-29"/>
    <tag k="subject:wikipedia" v="de:Wiener Gesera"/>
    <tag k="wikimedia_commons" v="File:Judenplatz-6 memorial plate.jpg"/>
  </node>
  <node id="9561522408" lat="48.2108188" lon="16.3680913" version="2" timestamp="2022-10-03T10:00:56Z" changeset="126927603" uid="10875409" user="Friendly_Ghost">
    <tag k="alt_name" v="Ehemaliger Babenberger Hof"/>
    <tag k="historic" v="memorial"/>
    <tag k="inscription" v="An dieser Stelle stand ein Hof der Babenberger Markgrafen|und Herzoge, später für die herzogliche Münze verwendet.|Das Haus wurde 1386 den Karmelitern übergeben, kam 1554|in den Besitz des Jesuitenordens und war zum Kriegsgebäude|umgebaut 1775-1913 Sitz.."/>
    <tag k="material" v="stone"/>
    <tag k="memorial" v="plaque"/>
    <tag k="name" v="Kriegsministerium am Hof"/>
    <tag k="ref:wien:kultur" v="97558"/>
    <tag k="wikimedia_commons" v="File:Kriegsministerium_am_Hof_2,_Wien.jpg"/>
  </node>
  <node id="9562452649" lat="48.2075436" lon="16.3733118" version="2" timestamp="2022-10-03T10:00:56Z" changeset="126927603" uid="10875409" user="Friendly_Ghost">
    <tag k="historic" v="memorial"/>
    <tag k="inscription" v="1938-1988|...|Mit 1.September 1938 lösten die Nationalsozialisten die Ballei Österreich des Deutschen Ordens auf. Am 24.März 1947 erklärte die Regierung der Republik Österreich die Auflösung für widerrechtlich und nichtig."/>
    <tag k="memorial" v="plaque"/>
    <tag k="name" v="Ballei Österreich des Deutschen Ordens"/>
