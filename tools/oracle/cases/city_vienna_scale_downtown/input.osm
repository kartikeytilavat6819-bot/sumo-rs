  <node id="12958966916" lat="48.2113786" lon="16.3700488" version="1" timestamp="2025-06-28T08:04:03Z" changeset="168216459" uid="472814" user="paoso">
    <tag k="artwork_type" v="relief"/>
    <tag k="description" v="Relief mit einer Darstellung der Taufe Jesu am Jordan als Anspielung auf den Namen des Hausbesitzers Jörg Jordan; darunter eine antisemitische Inschrift, die die Wiener Gesera (Vertreibung und Ermordung der Wiener Juden im Jahr 1421) feiert"/>
    <tag k="inscription" v="Flumine Jordani terguntur labe malisque corpora cum cedit, quod latet omne nefas. Sic flamma assurgens totam furibunda per urbem 1421 Hebraeum purgat crimina saeva canum. Deucalioneis mundus purgatur ab undis Sicque iterum poenas igne furiente luit."/>
    <tag k="inscription:de" v="… So erhob sich 1421 die Flamme des Hasses, wütete durch die ganze Stadt und sühnte die furchtbaren Verbrechen der Hebräerhunde. Wie damals die Welt durch die Sintflut gereinigt wurde, so sind durch das Wüten des Feuers alle Strafen verbüßt."/>
    <tag k="source:inscription" v="de.wikipedia.org/wiki/Judenplatz_(Wien)#Jordan-Haus"/>
    <tag k="source:start_date" v="de.wikipedia.org/wiki/Judenplatz_(Wien)#Jordan-Haus"/>
    <tag k="start_date" v="1497"/>
    <tag k="subject:wikipedia" v="de:Wiener Gesera"/>
    <tag k="tourism" v="artwork"/>
    <tag k="wikimedia_commons" v="File:Judenplatz_2_IMG_5709.JPG"/>
  </node>
