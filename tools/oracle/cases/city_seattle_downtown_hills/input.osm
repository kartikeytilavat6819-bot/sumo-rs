  <tag k="location" v="Central Library, east wall atrium"/>
  <tag k="measurements" v="Projector bracket/basket 20 x 15.5 x 17;Wall plate 26 x 10 x 4;Extension Arm from wall approx 37;vertical shaft on north mount 14 1/4-south 21 1/4"/>
  <tag k="media" v="Two-channel video projection, four video projectors with customized wall mounts, two channel synch box, two DVD players and two DVD's"/>
  <tag k="name" v="Astronomy by Day (and Other Oxymorons)"/>
  <tag k="project" v="LIBRARIES FOR ALL--CENTRAL LIBRARY"/>
  <tag k="sac_id" v="LIB05.002"/>
  <tag k="tourism" v="artwork"/>
 </node>
