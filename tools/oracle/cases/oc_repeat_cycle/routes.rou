<routes>
    <!-- repeated routes with cycleTime: until shifts by a full cycle on each lap -->
    <vType id="car" length="5.00" maxSpeed="13.89" accel="2.60" decel="4.50"/>
    <route id="loop" edges="a b c d" repeat="2" cycleTime="100">
        <stop lane="b_0" endPos="100" duration="6"/>
        <stop lane="c_0" endPos="150" until="60" extension="5"/>
    </route>
    <vehicle id="v0" type="car" route="loop" depart="0" departSpeed="max"/>
    <vehicle id="v1" type="car" route="loop" depart="5" departSpeed="max"/>
    <flow id="f" type="car" route="loop" begin="20" end="80" period="20" departSpeed="max"/>
    <route id="loop2" edges="a b c d" repeat="3">
        <stop lane="d_0" endPos="80" duration="4"/>
    </route>
    <vehicle id="w0" type="car" route="loop2" depart="10" departSpeed="max"/>
</routes>
