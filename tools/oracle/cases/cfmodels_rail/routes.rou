<routes>
    <!-- slow Krauss leader heading east; the follower and the westbound train use DEFAULT_RAILTYPE (overridden per variant) -->
    <vType id="slowTrain" vClass="rail" length="50" accel="1.0" decel="1.0" maxSpeed="10" minGap="2"/>
    <route id="east" edges="w_r1 r1_j1 j1_j2_main j2_r2 r2_e"/>
    <route id="west" edges="e_r2 r2_j2 j2_j1_main j1_r1 r1_w"/>
    <vehicle id="slowEast" type="slowTrain" route="east" depart="0"/>
    <vehicle id="followEast" type="DEFAULT_RAILTYPE" route="east" depart="8"/>
    <vehicle id="trainWest" type="DEFAULT_RAILTYPE" route="west" depart="3"/>
</routes>
