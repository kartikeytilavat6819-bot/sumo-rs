<routes>
    <!-- Fractional step length: depart times and fcd sampling fall between whole seconds. -->
    <vType id="car" length="5.00" maxSpeed="13.89" accel="2.60" decel="4.50" sigma="0"/>
    <route id="r" edges="A"/>
    <vehicle id="v0" type="car" route="r" depart="0.25" departSpeed="max"/>
    <vehicle id="v1" type="car" route="r" depart="3.75" departSpeed="max"/>
    <flow id="f" type="car" route="r" begin="10.00" end="40.00" period="2.50" departSpeed="max"/>
</routes>
