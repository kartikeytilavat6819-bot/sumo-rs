<routes>
    <vType id="trolleybus" accel="0.8" decel="1.0" length="12" maxSpeed="18.0" sigma="0.0" minGap="2.5" color="0,1,0" emissionClass="Energy/unknown" vClass="bus" guiShape="bus/trolley" mass="13000">
        <param key="maximumBatteryCapacity" value="46000"/>
        <param key="overheadWireChargingPower" value="40000"/>
        <param key="maximumPower" value="160000"/>
        <param key="frontSurfaceArea" value="7.5"/>
        <param key="airDragCoefficient" value="0.59"/>
        <param key="rotatingMass" value="100"/>
        <param key="radialDragCoefficient" value="0.5"/>
        <param key="rollDragCoefficient" value="0.061"/>
        <param key="constantPowerIntake" value="6000"/>
        <param key="propulsionEfficiency" value="0.9"/>
        <param key="recuperationEfficiency" value="0.9"/>
    </vType>

    <route id="r_east" color="1,0,0" edges="w2m m2e"/>
    <route id="r_west" color="1,0,0" edges="e2m m2w"/>

    <vehicle id="test1" type="trolleybus" depart="0" departLane="0" departPos="0" route="r_east">
        <param key="actualBatteryCapacity" value="23000"/>
    </vehicle>
    <vehicle id="test2" type="trolleybus" depart="5" departLane="0" departPos="0" route="r_west">
        <param key="actualBatteryCapacity" value="23000"/>
    </vehicle>
    <vehicle id="test3" type="trolleybus" depart="10" departLane="1" departPos="0" route="r_east">
