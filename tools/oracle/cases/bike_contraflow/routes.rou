<routes>
    <vType id="car" vClass="passenger" length="4.50" maxSpeed="13.89" accel="2.00" decel="4.50"/>
    <vType id="bike" vClass="bicycle" length="1.80" width="0.60" maxSpeed="6.00" accel="1.20" decel="2.50"/>
    <!-- cars travel a0->a1 on E0; bikes use the contra-flow lane E1 (a1->a0) -->
    <vehicle id="car0" type="car" depart="0.00" departSpeed="max"><route edges="E0"/></vehicle>
    <vehicle id="bike0" type="bike" depart="2.00" departSpeed="max"><route edges="E1"/></vehicle>
    <vehicle id="car1" type="car" depart="4.00" departSpeed="max"><route edges="E0"/></vehicle>
    <vehicle id="bike1" type="bike" depart="6.00" departSpeed="max"><route edges="E1"/></vehicle>
    <vehicle id="car2" type="car" depart="8.00" departSpeed="max"><route edges="E0"/></vehicle>
    <vehicle id="bike2" type="bike" depart="10.00" departSpeed="max"><route edges="E1"/></vehicle>
    <vehicle id="bike3" type="bike" depart="14.00" departSpeed="max"><route edges="E1"/></vehicle>
</routes>
