<routes>
    <!-- a slow vehicle blocks lane 0 of A; fast vehicles on lane 0 must change lanes to overtake (lanechange.duration) -->
    <vType id="vSlow" length="5.00" maxSpeed="4.00" accel="2.60" decel="4.50"/>
    <vType id="vFast" length="5.00" maxSpeed="13.89" accel="2.60" decel="4.50"/>
    <route id="r0" edges="A B"/>
    <vehicle id="slow0" type="vSlow" route="r0" depart="0.00" departLane="0" departSpeed="max"/>
    <flow id="fFast" type="vFast" route="r0" begin="3.00" end="80.00" period="4.00" departLane="0" departSpeed="max"/>
    <flow id="fFastR" type="vFast" route="r0" begin="5.00" end="80.00" period="5.00" departLane="1" departSpeed="max"/>
</routes>
