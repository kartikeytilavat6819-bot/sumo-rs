<routes>
    <!-- personTrip with modes=taxi: the intermodal router must pick the taxi for the trip. -->
    <vType id="taxi" vClass="taxi" length="5.00" maxSpeed="13.89" accel="2.60" decel="4.50">
        <param key="has.taxi.device" value="true"/>
    </vType>
    <route id="AB" edges="A B"/>
    <vehicle id="taxi0" type="taxi" depart="0" route="AB"/>
    <vehicle id="taxi1" type="taxi" depart="50" route="AB"/>
    <person id="p0" depart="5" departPos="100">
        <personTrip from="A" to="B" modes="taxi"/>
    </person>
    <person id="p1" depart="30" departPos="250">
        <personTrip from="A" to="B" modes="taxi"/>
    </person>
    <person id="p2" depart="70" departPos="150">
        <personTrip from="A" to="B" modes="taxi"/>
    </person>
</routes>
