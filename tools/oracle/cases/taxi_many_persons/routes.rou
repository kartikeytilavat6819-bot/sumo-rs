<routes>
    <!-- 4 taxis, 14 persons over 260 s, greedy with dispatch every 30 s. -->
    <vType id="taxi" vClass="taxi" length="5.00" maxSpeed="13.89" accel="2.60" decel="4.50">
        <param key="has.taxi.device" value="true"/>
    </vType>
    <route id="AB" edges="A B"/>
    <vehicle id="taxi0" type="taxi" depart="0" route="AB"/>
    <vehicle id="taxi1" type="taxi" depart="25" route="AB"/>
    <vehicle id="taxi2" type="taxi" depart="50" route="AB"/>
    <vehicle id="taxi3" type="taxi" depart="75" route="AB"/>
    <person id="p0" depart="3" departPos="131"><ride from="A" to="B" lines="taxi"/></person>
    <person id="p1" depart="18" departPos="186"><ride from="A" to="B" lines="taxi"/></person>
    <person id="p2" depart="33" departPos="241"><ride from="A" to="B" lines="taxi"/></person>
