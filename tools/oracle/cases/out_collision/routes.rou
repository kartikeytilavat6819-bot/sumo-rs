<?xml version="1.0" encoding="UTF-8"?>
<routes>
    <vType id="car" sigma="0.5"/>
    <vType id="reckless" sigma="0.5" jmIgnoreFoeProb="1" jmIgnoreFoeSpeed="50" jmIgnoreJunctionFoeProb="1"/>
    <vType id="truck" vClass="truck" length="12" maxSpeed="25" accel="1.2" decel="4" sigma="0.5"/>
    <route id="rA" edges="-103224#0 -103224#1 -103224#2 -103224#3"/>
    <route id="rB" edges="-103227#0 -103227#1 -103227#2"/>
    <route id="rC" edges="--103227#2 --103227#1 --103227#0"/>
    <route id="rD" edges="-103226#0 -103226#1"/>
    <route id="rE" edges="-103224#0 -103224#1 -103227#2"/>
    <route id="rF" edges="--103227#2 -103224#2 -103224#3"/>
    <route id="rG" edges="-103228 -103227#1 -103227#2"/>
    <route id="rH" edges="-103230 -103224#3"/>
    <flow id="fA" type="reckless" route="rA" begin="0" end="150" period="6" departLane="random" departSpeed="max"/>
    <flow id="fB" type="reckless" route="rB" begin="0" end="150" period="8" departLane="random" departSpeed="max"/>
    <flow id="fC" type="truck" route="rC" begin="0" end="150" period="12" departSpeed="max"/>
    <flow id="fD" type="reckless" route="rD" begin="0" end="150" period="15" departSpeed="max"/>
    <flow id="fE" type="reckless" route="rE" begin="0" end="150" period="14" departSpeed="max"/>
    <flow id="fF" type="reckless" route="rF" begin="0" end="150" period="16" departSpeed="max"/>
    <flow id="fG" type="truck" route="rG" begin="0" end="150" period="20" departSpeed="max"/>
    <flow id="fH" type="reckless" route="rH" begin="0" end="150" period="20" departSpeed="max"/>
</routes>
