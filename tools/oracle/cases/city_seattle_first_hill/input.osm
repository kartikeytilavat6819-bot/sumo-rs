  <tag k="artist_name" v="Paul Kuniholm"/>
  <tag k="artwork_type" v="mural"/>
  <tag k="description" v="Mural commissioned by the Low Income Housing Institute for application on an atrium, the north elevation of the Frye Parking Garage.  Paying homage to fellow swede Oscar Reutersvard, including an ambiguous perspective motif."/>
