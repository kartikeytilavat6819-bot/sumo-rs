<routes>
    <!-- taxistand idle: idle taxis are rerouted to the stand on A (rerouter rr0). -->
    <vType id="taxi" vClass="taxi" length="5.00" maxSpeed="13.89" accel="2.60" decel="4.50">
        <param key="has.taxi.device" value="true"/>
        <param key="device.taxi.stands-rerouter" value="rr0"/>
    </vType>
    <route id="AB" edges="A B"/>
    <vehicle id="taxi0" type="taxi" depart="0" route="AB"/>
    <vehicle id="taxi1" type="taxi" depart="40" route="AB"/>
    <person id="p0" depart="100" departPos="100"><ride from="A" to="B" lines="taxi"/></person>
    <person id="p1" depart="130" departPos="300"><ride from="A" to="B" lines="taxi"/></person>
    <person id="p2" depart="260" departPos="200"><ride from="A" to="B" lines="taxi"/></person>
</routes>
