<routes>
    <vTypeDistribution id="vd">
        <vType id="calm" carFollowModel="Krauss" length="5.00" maxSpeed="13.89" accel="2.60" decel="4.50" sigma="0.5" speedDev="0.1" probability="0.5"/>
