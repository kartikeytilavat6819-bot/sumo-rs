 <node id="12054461831" visible="true" version="19" changeset="169030043" timestamp="2025-07-16T19:30:43Z" user="Robot8A" uid="393359" lat="52.3638377" lon="4.8827605">
  <tag k="artist_name" v="Rini Hurkmans"/>
  <tag k="artist:wikidata" v="Q23006548"/>
  <tag k="artist:wikipedia" v="nl:Rini Hurkmans"/>
  <tag k="artwork_type" v="sculpture"/>
  <tag k="colour" v="#90EE90"/>
  <tag k="description" v="monument ter herdenking van Peter R. de Vries, die is vermoord door criminelen. Onthulling op nationale tv: https://npo.nl/start/serie/monument-voor-peter-r-de-vries/seizoen-1/onthulling-monument-peter-r-de-vries/af"/>
  <tag k="description:en" v="memorial in remembrance of Peter R. de Vries (fighter against injustice), who was murdered by criminals. Memorial reveal on national TV: https://npo.nl/start/serie/monument-voor-peter-r-de-vries/seizoen-1/onthulling-monument-peter-r-de-vries/af"/>
  <tag k="height" v="2.85"/>
  <tag k="image" v="https://www.amsterdam.nl/publish/pages/1055775/dsc_0743940.jpg"/>
  <tag k="inscription" v="Blijf wie je bent... houd als het nodig is je rug recht, kom op voor zwakkeren en minderheden, zeg eerlijk wat je vindt en luister naar je rechtvaardigheidsgevoel."/>
  <tag k="inscription:en" v="Stay who you are ... keep your back straight when necessary, stand up for the weak and minorities, say honestly what you think and listen to your sense of justice."/>
  <tag k="length" v="5.25"/>
  <tag k="material" v="bronze"/>
  <tag k="name" v="Tegen alle stromen in"/>
  <tag k="subject" v="Peter R. de Vries"/>
  <tag k="subject:wikidata" v="Q1944867"/>
  <tag k="subject:wikipedia" v="nl:Peter R. de Vries"/>
  <tag k="tourism" v="artwork"/>
  <tag k="url" v="https://www.2doc.nl/documentaires/2024/07/het-monument-peter-r-de-vries.html"/>
  <tag k="website" v="https://www.amsterdam.nl/herdenkingsmonument-peter-vries/?print=true"/>
  <tag k="width" v="2.75"/>
  <tag k="wikidata" v="Q127462101"/>
  <tag k="wikimedia_commons" v="File:2024 Tegen alle stromen in-Leidseplein, Asd (B).jpg"/>
  <tag k="wikipedia" v="nl:Tegen alle stromen in"/>
 </node>
