<routes>
    <!-- friendlyPos shifts partially/fully out-of-lane stop positions back onto the 300 m lanes -->
    <vType id="car" length="5.00" maxSpeed="13.89" accel="2.60" decel="4.50"/>
    <route id="r" edges="A B C D"/>
    <vehicle id="f0" type="car" route="r" depart="0" departSpeed="max">
        <stop lane="B_0" startPos="250.00" endPos="380.00" friendlyPos="true" duration="5"/>
    </vehicle>
    <vehicle id="f1" type="car" route="r" depart="4" departSpeed="max">
        <stop lane="C_0" endPos="350.00" friendlyPos="true" duration="5"/>
    </vehicle>
    <vehicle id="f2" type="car" route="r" depart="8" departSpeed="max">
        <stop lane="B_0" startPos="-20.00" endPos="40.00" friendlyPos="true" duration="5"/>
    </vehicle>
    <vehicle id="f3" type="car" route="r" depart="12" departSpeed="max">
        <stop lane="B_0" endPos="300.00" friendlyPos="false" duration="5"/>
    </vehicle>
    <vehicle id="f4" type="car" route="r" depart="16" departSpeed="max">
        <stop edge="C" endPos="350.00" friendlyPos="true" duration="5"/>
    </vehicle>
    <vehicle id="f5" type="car" route="r" depart="20" departSpeed="max">
        <stop lane="B_0" startPos="120.00" endPos="80.00" friendlyPos="true" duration="5"/>
    </vehicle>
</routes>
